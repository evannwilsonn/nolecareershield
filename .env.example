# Copy to .env for local use, or set these in your host's dashboard.
# NEVER commit a real .env file (it is in .gitignore).

# development | production. Production refuses to start with weak settings.
ENV=development

# Required in production: 12+ characters.
ADMIN_PASSWORD=

# Required in production: 32+ random characters.
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Required in production: shown on the Privacy and Report pages.
CONTACT_EMAIL=

# Where the SQLite file lives. Point at a persistent disk in production.
DB_PATH=jobs.db

# Public https address of the site. Every link in an email is built from this.
BASE_URL=http://127.0.0.1:8000

# Outgoing email (confirmation and password reset). Required in production.
# Leave SMTP_HOST empty in development: emails are written to OUTBOX_LOG instead.
SMTP_HOST=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
# Set to 1 for implicit TLS (port 465).
SMTP_SSL=0
OUTBOX_LOG=outbox.log

# Optional Cloudflare Turnstile bot check. Set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Set to 1 only when behind exactly one trusted proxy (Render, Railway, Fly).
TRUST_PROXY=0
# With TRUST_PROXY=1: a header your CDN overwrites with the visitor's address (on Render this defaults to
# cf-connecting-ip,true-client-ip). Otherwise the X-Forwarded-For entry TRUST_PROXY_HOPS from the right is used.
# After deploying, open /admin/client-ip and check it shows your own public IP.
CLIENT_IP_HEADER=
TRUST_PROXY_HOPS=1

# Rate limits and input caps (the defaults are what's shown). Every endpoint: requests per IP per minute.
RATE_LIMIT_PER_MIN=300
# Log-in lockout: failed attempts per IP per window (successful log-ins don't count). Per account, the same
# limit applies per IP, plus ACCOUNT_MAX_FAILS across all addresses.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15
ACCOUNT_MAX_FAILS=20
# Browsers that have logged in before get their own 5 tries, so a shared campus address isn't locked out by strangers;
# together they're capped at this many failures per address per window.
LOGIN_SHARED_IP_MAX=50
# Where rate limits are kept: sqlite (default in production; shared by all worker processes) or memory.
RATE_LIMIT_STORE=
# Defaults to ratelimit.db next to DB_PATH.
RATE_LIMIT_DB=
# Largest request body: forms and JSON (KB), and file uploads (MB).
MAX_BODY_KB=128
MAX_UPLOAD_MB=9
# Uploaded files are parsed in a separate process that is stopped after this many seconds.
PARSE_TIMEOUT_SECONDS=10
# How many uploaded files can be parsed at the same time (more are asked to try again in a minute).
PARSE_MAX_PARALLEL=2

# Approved listings stop showing after this many days.
LISTING_TTL_DAYS=90
# Rejected/removed submissions are deleted after this many days.
PURGE_REJECTED_DAYS=90

# Daily upkeep: purge expired data and back up the database (hours between runs; 0 turns it off).
MAINTENANCE_HOURS=24
# Backups go next to the database by default (/data/backups on Render). Newest BACKUP_KEEP are kept.
BACKUP_DIR=
BACKUP_KEEP=14

# ---- AI features (optional) ----
# With no key, the job assistant, resume reviewer/tailor, scam checker and feed moderation
# all run on the built-in rule-based engines. With a key they also use Claude (Anthropic).
# Get a key at console.anthropic.com. Keep it only in your host's dashboard, never in git.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI requests per signed-in person per day, and for the whole site per day (cost ceiling).
AI_DAILY_LIMIT=40
AI_SITE_DAILY_LIMIT=3000

# ---- Scam intel (all optional; each outside check stays off until its key is set) ----
# Network lookups (domain age, SPF/DMARC, link expansion, certificate-log watch). Default: on when ENV=production.
INTEL_NETWORK=
# Keys the hashed contact-detail memory. Defaults to one derived from SECRET_KEY; set it to rotate independently.
INDICATOR_KEY=
URLHAUS_AUTH_KEY=
SPAMHAUS_DQS_KEY=
CHAINABUSE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sharing confirmed-scam details (as hashes) with partner schools. SHARE_HMAC_KEY must be the same at every school.
SHARE_HMAC_KEY=
SHARE_FEED_KEY=
SHARE_SOURCE_NAME=NoleCareerShield (FSU)
# Partner feeds to pull daily: https://their-site/api/indicators|their-feed-key,https://...|...
PEER_FEEDS=
# RSS/Atom feeds of published job scams, added weekly to the label queue.
ARCHIVE_FEEDS=
# Forward-by-email checks: the secret in the inbound-parse webhook URL (/inbound/email?token=...).
INBOUND_EMAIL_TOKEN=
# The decoy desk. Leave off until FSU legal has signed off.
DECOY_ENABLED=

# ---- Scam model releases and measurement (defaults shown) ----
# Retrain: monthly fallback at RETRAIN_MIN_NEW distinct new labels; early at RETRAIN_EVIDENCE_MIN or a confirmed new campaign.
RETRAIN_DAYS=30
RETRAIN_MIN_NEW=20
RETRAIN_EVIDENCE_MIN=30
RETRAIN_CAMPAIGN_MIN=3
RETRAIN_MIN_GAP_DAYS=3
RETRAIN_WAVE_CAP=3
# A new model is scored in the background, then served to 10%, 50%, 100% of listings. 0 = wait for a reviewer at each step.
# SCAM_MODEL=off turns the learned model off (rules only). SCAM_RULEPACK_EXTRA points at a JSON file of hot-fix rules.
SCAM_MODEL=on
SCAM_RULEPACK_EXTRA=
MODEL_AUTO_RELEASE=1
RELEASE_SHADOW_DAYS=7
RELEASE_STAGES=10,50,100
RELEASE_STAGE_DAYS=3
RELEASE_WATCH_DAYS=14
RELEASE_FRESH_MIN=5
# Listing checks both models must score in background before a stage can advance.
RELEASE_TRAFFIC_MIN=30
RELEASE_FP_MAX_RATE=0.02
# Share of "safe" scam-check results sent to reviewers to find confident misses, and the daily cap.
LOW_RISK_SAMPLE_RATE=0.03
LOW_RISK_SAMPLE_DAILY_MAX=8

# ---- FSU single sign-on for students (optional) ----
# Students type their @fsu.edu address and sign in on FSU's own Microsoft page (with Duo); this site never
# sees their FSU password. FSU ITS must register this site as an app in FSU's Microsoft Entra tenant with the
# redirect URI {BASE_URL}/sso/callback and give you these three values. Keep the secret only in your host's
# dashboard. Leave all three empty to use email + password only.
SSO_NAME=FSU
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
