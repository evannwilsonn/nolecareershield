# Copy to .env for local use, or set these in your host's dashboard.
# NEVER commit a real .env file (it is in .gitignore).

# development | production. Production refuses to start with weak settings.
ENV=development

# Required in production: 12+ characters.
ADMIN_PASSWORD=

# Required in production: 32+ random characters.
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Required in production: shown on the Privacy and Report pages.
CONTACT_EMAIL=

# Where the SQLite file lives. Point at a persistent disk in production.
DB_PATH=jobs.db

# Public https address of the site. Every link in an email is built from this.
BASE_URL=http://127.0.0.1:8000

# Outgoing email (confirmation and password reset). Required in production.
# Leave SMTP_HOST empty in development: emails are written to OUTBOX_LOG instead.
SMTP_HOST=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
# Set to 1 for implicit TLS (port 465).
SMTP_SSL=0
OUTBOX_LOG=outbox.log

# Optional Cloudflare Turnstile bot check. Set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Set to 1 only when behind exactly one trusted proxy (Render, Railway, Fly).
TRUST_PROXY=0

# Approved listings stop showing after this many days.
LISTING_TTL_DAYS=90
# Rejected/removed submissions are deleted after this many days.
PURGE_REJECTED_DAYS=90

# Daily upkeep: purge expired data and back up the database (hours between runs; 0 turns it off).
MAINTENANCE_HOURS=24
# Backups go next to the database by default (/data/backups on Render). Newest BACKUP_KEEP are kept.
BACKUP_DIR=
BACKUP_KEEP=14

# ---- AI features (optional) ----
# With no key, the job assistant, resume reviewer/tailor, scam checker and feed moderation
# all run on the built-in rule-based engines. With a key they also use Claude (Anthropic).
# Get a key at console.anthropic.com. Keep it only in your host's dashboard, never in git.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI requests per signed-in person per day, and for the whole site per day (cost ceiling).
AI_DAILY_LIMIT=40
AI_SITE_DAILY_LIMIT=3000

# ---- FSU single sign-on for students (optional) ----
# Students type their @fsu.edu address and sign in on FSU's own Microsoft page (with Duo); this site never
# sees their FSU password. FSU ITS must register this site as an app in FSU's Microsoft Entra tenant with the
# redirect URI {BASE_URL}/sso/callback and give you these three values. Keep the secret only in your host's
# dashboard. Leave all three empty to use email + password only.
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
