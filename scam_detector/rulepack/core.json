{
 "version": "2026.09.29",
 "rules": [
  {
   "id": "advance_fee",
   "status": "active",
   "severity": "critical",
   "weight": 30,
   "title": "You're asked to pay something",
   "why": "Legitimate employers never charge you to start work. The single most reliable scam marker.",
   "phrases": [
    "training fee",
    "registration fee",
    "application fee",
    "processing fee",
    "onboarding fee",
    "background check fee",
    "starter kit",
    "pay for your own equipment",
    "purchase the equipment",
    "buy the software",
    "refundable deposit",
    "security deposit",
    "administrative fee",
    "certification fee",
    "check to purchase",
    "check for equipment",
    "check to buy",
    "funds to purchase",
    "money for equipment",
    "training with a fee"
   ],
   "patterns": [
    "\\b(?:fees?|tuition|charges?)\\b[^.\\n]{0,40}\\b(?:training|course|program|certification|onboarding|registration|processing|kit|equipment|softwares?|laptop|visa)\\b",
    "\\b(?:training|course|program|certification|onboarding|registration|application|processing|visa|equipment|software|kit)\\s+(?:fees?|charges?|tuition|costs?)\\b",
    "\\$\\s?\\d[\\d,]*(?:\\.\\d\\d)?\\s+(?:paid\\s+)?(?:certification|training|course|program|mentorship|kit|software|equipment)\\b",
    "\\b(?:must|need to|have to|required to|first)\\b[^.\\n]{0,30}\\b(?:obtain|purchase|buy|pay(?: for)?)\\b[^.\\n]{0,30}\\$\\s?\\d[\\d,]*[^.\\n]{0,20}\\b(?:certification|training|course|program|onboarding|software|equipment|vendor|kit|fee)\\b",
    "\\b(?:pay|paying|send)\\s+(?:the\\s+|our\\s+|an?\\s+)?(?:vendor|hr agent|agent|recruiter|supplier)\\b[^.\\n]{0,40}\\$?\\s?\\d",
    "\\bpay\\b[^.\\n]{0,40}\\$\\s?\\d[\\d,]*[^.\\n]{0,40}\\b(?:to our|to the)\\s+(?:hr\\s+)?(?:agent|recruiter|manager|vendor)\\b",
    "\\b(?:are you able to|can you|could you|please|kindly|you (?:will )?(?:need to|must|have to))\\s+(?:\\w+\\s+){0,2}(?:cover|front|pay for)\\s+(?:the\\s+|these\\s+|those\\s+)?(?:expenses?|costs?|fees?)\\b"
   ],
   "guards": [
    "negation"
   ],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "money_mule",
   "status": "active",
   "severity": "critical",
   "weight": 34,
   "title": "The job involves moving money or packages",
   "why": "Depositing checks and forwarding funds, or reshipping parcels, is how stolen money and goods get laundered.",
   "phrases": [
    "deposit the check",
    "cash the check",
    "cashier's check",
    "cashiers check",
    "forward the funds",
    "transfer the remaining",
    "wire the balance",
    "process payments on behalf",
    "package forwarding",
    "reship",
    "money transfer agent"
   ],
   "patterns": [
    "\\b(?:mail|send|issue|email|deliver|give)\\w*\\s+you\\s+(?:a\\s+|the\\s+)?(?:check|cheque|paycheck)\\b[^.\\n]{0,90}\\b(?:deposit|purchase|equipment|supplies|expenses|software|vendor)\\b",
    "\\b(?:attached|enclosed)\\s+is\\s+the\\s+(?:pay)?check\\b[^.\\n]{0,60}\\b(?:cover|expenses|supplies|purchase)\\b",
    "\\bkeep\\s+(?:\\$\\s?\\d[\\d,]*|\\d{1,3}\\s?%)[^.\\n]{0,60}\\b(?:pay|salary|commission|fee|cut)\\b",
    "\\b(?:customers?|clients?|buyers?)\\s+(?:will\\s+)?(?:pay|send|deposit)\\s+(?:into|to)\\s+your\\s+(?:personal\\s+|own\\s+)?(?:bank\\s+)?account\\b",
    "\\b(?:transfer|send|wire|forward|remit)\\b[^.\\n]{0,40}\\b\\d{1,3}\\s?%[^.\\n]{0,40}\\b(?:partner|account|us|our|company)\\b",
    "\\b(?:receive|accept|inspect)\\s+(?:the\\s+)?(?:parcels?|packages?|shipments?|boxes|goods)\\b[^.\\n]{0,80}\\b(?:your\\s+(?:home\\s+)?address|your\\s+home|at\\s+home|residence)\\b",
    "\\b(?:relabel|re-?label|repackage|re-ship)\\w*\\b",
    "\\bprepaid\\s+(?:shipping\\s+)?labels?\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "mystery_shopping",
   "status": "active",
   "severity": "warning",
   "weight": 16,
   "title": "Mystery-shopper work",
   "why": "Real mystery shopping exists, but 'mystery shopper' is also the usual cover story for fake-check scams. Never deposit a check or send money as part of an assignment.",
   "phrases": [
    "mystery shopper",
    "secret shopper",
    "mystery shopping"
   ],
   "patterns": [],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "banking_pii",
   "status": "active",
   "severity": "critical",
   "weight": 26,
   "title": "Banking or identity details wanted up front",
   "why": "Account and identity details come after a signed offer, through payroll, never over chat during screening.",
   "phrases": [
    "routing number",
    "bank account number",
    "voided check",
    "social security number",
    "your ssn",
    "driver's license number",
    "drivers license number",
    "copy of your id",
    "photo of your id",
    "direct deposit form"
   ],
   "patterns": [
    "\\b(?:send|provide|share|text|email|upload|scan|snap|attach)\\b[^.\\n]{0,50}\\b(?:ssn|social security|driver'?s? licen[sc]e|passport|bank (?:account|details|info\\w*|login)|routing|account number|photo id|id card)\\b"
   ],
   "guards": [
    "negation",
    "post_hire"
   ],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "irreversible_pay",
   "status": "active",
   "severity": "critical",
   "weight": 24,
   "title": "Payment through irreversible channels",
   "why": "Gift cards, crypto, and peer-to-peer apps can't be reversed or traced. No payroll uses them.",
   "phrases": [],
   "patterns": [
    "\\b(?:pay|paid|payment|payments|salary|send|sent|deposit|transfer|buy|purchase|codes?|top\\s?up|recharge|wire|withdraw\\w*)\\b[^.\\n]{0,40}\\b(?:bitcoin|btc|usdt|usdc|crypto(?:currency)?|gift\\s+cards?|apple\\s+cards?|itunes|zelle|cash\\s?app|venmo|western\\s+union|moneygram)\\b",
    "\\b(?:bitcoin|btc|usdt|usdc|crypto(?:currency)?|gift\\s+cards?|apple\\s+cards?|itunes|zelle|cash\\s?app|venmo|western\\s+union|moneygram)\\b[^.\\n]{0,25}\\b(?:paid|payment|payments|salary|deposit|transfer|codes?)\\b"
   ],
   "guards": [
    "negation"
   ],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "task_scam",
   "status": "active",
   "severity": "warning",
   "weight": 24,
   "title": "Looks like a 'task' scam",
   "why": "Task scams pay small commissions for fake product-boosting work, then demand deposits to 'unlock' withdrawals. You never get the money back.",
   "phrases": [],
   "patterns": [
    "\\b(?:boost|increase|improve|raise)\\w*\\s+(?:the\\s+)?(?:product\\s+|app\\s+|merchant\\s+|store\\s+)?(?:ratings?|rankings?|reviews?)\\b",
    "\\b(?:product|order|app)\\s+optimi[sz]ation\\b",
    "\\bcommission\\s+(?:on|per|for)\\s+(?:every|each|all)\\s+(?:set|task|order|product)\\b",
    "\\b(?:top\\s?up|recharge|reload|fund)\\s+(?:your\\s+)?(?:account|balance|wallet)\\b",
    "\\bunlock\\s+(?:your\\s+)?(?:withdrawal|earnings|commissions?|tasks?|bonus)\\b",
    "\\bwithdraw(?:al|als)?\\b[^.\\n]{0,50}\\b(?:top\\s?up|recharge|deposit|unlock|upgrade)\\b",
    "\\b(?:like|rate|review|click)\\s+(?:and\\s+\\w+\\s+)?(?:products?|videos?|ads?|apps?|listings?)\\b[^.\\n]{0,40}\\b(?:earn|paid|commission)\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "off_platform",
   "status": "active",
   "severity": "warning",
   "weight": 17,
   "title": "Pushed onto a messaging app",
   "why": "Moving to an unmonitored app right away avoids platform fraud detection and leaves no record.",
   "phrases": [
    "telegram",
    "whatsapp",
    "google hangouts",
    "signal app",
    "wickr",
    "skype id",
    "add me on",
    "message me at",
    "text me at",
    "dm me on"
   ],
   "patterns": [
    "\\b(?:provide|send|share)\\s+(?:us\\s+|me\\s+)?your\\s+(?:microsoft\\s+)?teams\\s+(?:contact|id|email|username|handle|details)\\b",
    "\\bteams\\s+for\\s+(?:direct\\s+)?communication\\b",
    "\\b(?:only|exclusively|just)\\s+(?:via|on|through|over)\\s+(?:whatsapp|telegram|signal|text|sms)\\b"
   ],
   "guards": [
    "negation"
   ],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "text_interview",
   "status": "active",
   "severity": "warning",
   "weight": 15,
   "title": "Interview by text only",
   "why": "Scam operations avoid live video because they're using a stolen or invented identity.",
   "phrases": [
    "chat interview",
    "text interview",
    "no video call",
    "interview through telegram",
    "interview via whatsapp",
    "written interview only"
   ],
   "patterns": [
    "\\binterview\\w*\\b[^.\\n]{0,40}\\b(?:via|on|through|over|by)\\s+(?:whatsapp|telegram|signal|text(?:\\s+message)?|chat|messages?|sms)\\b"
   ],
   "guards": [
    "negation"
   ],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "instant_hire",
   "status": "active",
   "severity": "warning",
   "weight": 16,
   "title": "Hired with no real process",
   "why": "An offer without an interview means nobody is assessing you. The goal is to reach the payment step fast.",
   "phrases": [
    "you have been hired",
    "congratulations you are hired",
    "no interview required",
    "hired on the spot",
    "your resume was selected",
    "begin work today"
   ],
   "patterns": [
    "\\bno\\s+interview\\b",
    "\\b(?:hired|hire[sd]?|start(?:ing)?|begin)\\b[^.\\n]{0,20}\\bsame[- ]day\\b",
    "\\byou(?:'ve| have)\\s+been\\s+(?:selected|hired|approved|accepted)\\b",
    "\\bdeemed\\s+qualified\\b",
    "\\byour\\s+(?:application|resume)\\s+(?:has\\s+been|was)\\s+(?:processed|selected|approved|shortlisted)\\b"
   ],
   "guards": [
    "negation"
   ],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "unsolicited_contact",
   "status": "active",
   "severity": "warning",
   "weight": 14,
   "title": "They say they found you through a directory or resume list",
   "why": "Scammers mass-mail lists of students and job seekers. A real employer applies to you, or you apply to them.",
   "phrases": [],
   "patterns": [
    "\\b(?:got|received|obtained|found|pulled|saw)\\s+your\\s+(?:contact|resume|cv|email|details|information)\\b[^.\\n]{0,60}\\b(?:through|from|via|on|in)\\b",
    "\\bselected\\s+from\\s+your\\s+(?:school|university|college|campus)\\s+directory\\b",
    "\\byour\\s+(?:school|university|college)\\s+(?:directory|email\\s+list|listserv)\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "university scam alerts, 2026-09"
  },
  {
   "id": "student_bait",
   "status": "active",
   "severity": "note",
   "weight": 9,
   "title": "Wording aimed at students",
   "why": "Campus scam alerts repeatedly show this framing: easy money that won't interfere with classes.",
   "phrases": [],
