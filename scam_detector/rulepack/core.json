    "reputable company seeking",
    "well known firm",
    "undisclosed company"
   ],
   "patterns": [
    "\\b(?:confidential|undisclosed)\\s+(?:employer|company|client)\\b"
   ],
   "guards": [],
   "min_matches": 1,
