    "\\bwithout affecting your (?:regular\\s+)?(?:activities|studies|academics|classes|schedule)\\b",
    "\\bstudent\\s+(?:empowerment|assistance|support)\\s+program\\b",
    "\\bwork\\s+virtually\\s+as\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "university scam alerts, 2026-09"
  },
  {
   "id": "pressure",
   "status": "active",
   "severity": "warning",
   "weight": 11,
   "title": "Pressure to decide now",
   "why": "Urgency is there to stop you checking. Real hiring runs on weeks, not hours.",
   "phrases": [
    "limited positions",
    "limited slots",
    "act fast",
    "respond within 24 hours",
    "within the next hour",
    "first come first served",
    "offer expires",
    "urgent hiring",
    "urgently needed"
   ],
   "patterns": [
    "\\burgently\\s+(?:needs?|required|hiring)\\b",
    "\\bstart\\s+(?:today|now|right away)\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "too_good",
   "status": "active",
   "severity": "warning",
   "weight": 13,
   "title": "High pay for very little",
   "why": "Pay well above market for a role needing no experience is bait, not an opportunity.",
   "phrases": [
    "no experience necessary",
    "no experience required",
    "no skills required",
    "anyone can do this",
    "work only 2 hours",
    "flexible hours high pay",
    "easy money",
    "guaranteed income",
    "earn while you learn"
   ],
   "patterns": [
    "\\bno\\s+(?:work\\s+)?experience(?:\\s+or\\s+skills?)?\\s+(?:is\\s+|are\\s+)?(?:necessary|required|needed)\\b",
    "\\bearn\\s+\\$\\s?\\d[\\d,]*(?:\\s*(?:-|to)\\s*\\$?\\s?\\d[\\d,]*)?\\s*(?:daily|a day|per day|every day)\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "pay_to_work",
   "status": "active",
   "severity": "warning",
   "weight": 20,
   "title": "The 'job' requires paying for training first",
   "why": "A real internship or job pays you. If you must buy a course or program to get the role, it is a course sale dressed as a job.",
   "phrases": [
    "enroll here",
    "enroll for the program",
    "enroll in the program"
   ],
   "patterns": [
    "\\benroll\\w*\\s+(?:for|in)\\s+(?:the|our)\\s+(?:training\\s+)?program\\b"
   ],
   "guards": [
    "negation"
   ],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "training_sale_perks",
   "status": "active",
   "severity": "warning",
   "weight": 20,
   "title": "The perks read like a course being sold",
   "why": "Certificates, mock interviews and branding sessions listed together are how paid 'internship programs' advertise themselves.",
   "phrases": [
    "training certificate",
    "internship certificate",
    "letter of recommendation",
    "mock interview sessions",
    "personal branding sessions",
    "resume building sessions",
    "guaranteed placement"
   ],
   "patterns": [],
   "guards": [],
   "min_matches": 2,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
   "id": "mule_recruitment",
   "status": "active",
   "severity": "warning",
   "weight": 22,
   "title": "Bank account and ID wanted to 'receive payment'",
   "why": "Being asked for a U.S. bank account and SSN to 'receive salary' before you know the job, company, or pay is the money-mule recruitment pattern; your account is used to move stolen funds.",
   "phrases": [
    "bank account for payment",
    "valid u.s. bank account",
    "us bank account for",
    "social security number for employment",
    "part-time recruiter"
   ],
   "patterns": [
    "\\b(?:valid|active|personal)\\s+(?:u\\.?s\\.?\\s+)?bank\\s+account\\b[^.\\n]{0,30}\\b(?:payment|paid|salary|deposit|receive)\\b",
    "\\b(?:receive|get|accept)\\s+(?:your\\s+)?(?:salary|pay|payments?|payroll)(?:\\s+payments?)?\\s+(?:through|via|by|into|to)\\s+(?:a\\s+|your\\s+)?(?:u\\.?s\\.?\\s+)?(?:personal\\s+)?bank\\b",
    "\\bassist(?:ing)?\\s+(?:\\w+\\s+){0,3}with\\s+(?:its|our|their|the)\\s+recruit(?:ment|ing)\\b",
    "\\brecruit(?:ment|ing)\\s+(?:is\\s+being\\s+)?conducted\\s+on\\s+behalf\\s+of\\b",
    "\\breply\\s+(?:with\\s+)?(?:yes|apply|interested|i'?m interested)\\b",
    "\\bnot\\s+eligible\\s+to\\s+apply\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-29",
   "source": "original"
  },
  {
